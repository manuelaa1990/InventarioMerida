# Cadena de conexión de Neon (usa la conexión "pooled" / PgBouncer).
# Neon la muestra en: Project -> Connect -> Connection string.
DATABASE_URL=postgresql://usuario:clave@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Contraseña del panel administrativo. Cámbiala por una larga y única.
ADMIN_PASSWORD=cambia-esta-clave

# Secreto para firmar la cookie de sesión (cadena aleatoria larga).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=cambia-este-secreto-por-uno-aleatorio-largo

# Token de Vercel Blob para subir las fotos de producto.
# En Vercel se crea al conectar el Blob store (Storage -> Blob).
# Solo hace falta en local para probar la subida de imágenes.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_cambia-este-token

# Opcional: si defines CRON_SECRET en Vercel, el cron diario de las tasas
# (BCV y USDT) lo enviará como Authorization: Bearer <CRON_SECRET>.
# CRON_SECRET=cambia-este-secreto-opcional
